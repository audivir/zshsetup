#!/bin/sh
# runs micromamba with a user-space glibc and patches newly installed glibc programs to use it
# see packages/micromamba.sh, packages/glibc.sh, and packages/patchelf.sh
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
micromamba="$data_home/micromamba-musl/micromamba"
sysroot="$data_home/glibc"
loader="$(echo "$sysroot"/lib64/ld-linux-*.so.*)"

patch_glibc() {
  find "$@" -type f -perm -u+x 2>/dev/null | while IFS= read -r file; do
    case "$(patchelf --print-interpreter "$file" 2>/dev/null)" in
      /lib*/ld-linux*) patchelf --set-interpreter "$loader" --add-rpath "$sysroot/lib64:$sysroot/usr/lib64" --force-rpath "$file" ;;
    esac
  done
}

# patching hardlinked files would also change the package cache
MAMBA_ALWAYS_COPY=true "$micromamba" "$@"
exit_code=$?
case "$1" in
  create | install | update | self-update | env)
    prefixes="${MAMBA_ROOT_PREFIX:-$data_home/micromamba}"
    while [ $# -gt 0 ]; do
      case "$1" in
        -p | --prefix) prefixes="$prefixes $2" ;;
        -p=* | --prefix=*) prefixes="$prefixes ${1#*=}" ;;
      esac
      shift
    done
    # shellcheck disable=SC2086
    patch_glibc "$micromamba" $prefixes
    ;;
esac
exit "$exit_code"
