#!/bin/sh
# runs pmg from its own venv, which it installs with the uv from PATH or one bootstrapped into
# the cache, and reinstalls when the pinned source changes
set -eu

zshsetup_home="${ZSHSETUP_HOME:-$HOME/.config/zshsetup}"
# the archive of a fixed tag, as uv would need git for a git URL; ZSHSETUP_PMG replaces it, e.g.
# with a local checkout, which is installed editable
pmg_tag="v1.1.1"
pmg="${ZSHSETUP_PMG:-https://github.com/audivir/pmg/archive/refs/tags/$pmg_tag.tar.gz}"
venv="${XDG_DATA_HOME:-$HOME/.local/share}/zshsetup/pmg"

export PMG_SPECS_DIR="${PMG_SPECS_DIR:-$zshsetup_home/packages/specs}"

# the fast path: the venv has the pinned source, and its python still exists
# python -m pmg, as the pmg script of uv needs a realpath with --, which BusyBox (Alpine) lacks
if [ -x "$venv/bin/python" ] && [ "$(cat "$venv/.source" 2>/dev/null)" = "$pmg" ]; then
  exec "$venv/bin/python" -m pmg "$@"
fi

# prints a URL with curl, wget, python3, or apt-helper, whichever exists
download() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O - "$1"
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import shutil, sys, urllib.request
shutil.copyfileobj(urllib.request.urlopen(sys.argv[1]), sys.stdout.buffer)' "$1"
  elif [ -x /usr/lib/apt/apt-helper ]; then
    # without CA certificates, the checksum below still guards the download
    file="$(mktemp)"
    /usr/lib/apt/apt-helper -o Acquire::https::Verify-Peer=false download-file "$1" "$file" >/dev/null
    cat "$file"
    rm -f "$file"
  else
    echo "pmg: curl, wget, python3, or apt-helper required to bootstrap uv" >&2
    return 1
  fi
}

# the gnu build of uv needs glibc 2.28, older glibc and musl get the static musl build
uv_libc() {
  glibc="$(getconf GNU_LIBC_VERSION 2>/dev/null | cut -d ' ' -f 2)"
  minor="${glibc#2.}"
  if [ -n "$glibc" ] && [ "${minor%%.*}" -ge 28 ]; then
    echo gnu
  else
    echo musl
  fi
}

# installs a fixed uv into $1, checked against its sha256
bootstrap_uv() {
  case "$(uname -s)-$(uname -m)-$(uv_libc)" in
    Linux-x86_64-gnu) target="x86_64-unknown-linux-gnu" sha256="23bf5552d220e0842b65c862097b2ebaeba0064b74eda5e565e77fd25969d8c8" ;;
    Linux-aarch64-gnu) target="aarch64-unknown-linux-gnu" sha256="0804e9b164c64b6914182d5920c08551958a095986f10a3731056df701126436" ;;
    Linux-x86_64-musl) target="x86_64-unknown-linux-musl" sha256="db7278c9f57981338fddff1fb250e11964bc0a4fafcb9eed8303fdb117dc067b" ;;
    Linux-aarch64-musl) target="aarch64-unknown-linux-musl" sha256="ad8d8448a2ff642ba62c2f684d7dd22a03f8eb3fc9918c2c3e8ec975f4ed6710" ;;
    Darwin-arm64-*) target="aarch64-apple-darwin" sha256="a9a8df1eedeb192f2e47e40e2faabfb387db4b850209118786d42f89dde3e0ba" ;;
    *)
      echo "pmg: no uv for $(uname -s) $(uname -m)" >&2
      return 1
      ;;
  esac
  asset="uv-$target.tar.gz"
  url="https://github.com/astral-sh/uv/releases/download/0.12.19/$asset"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  download "$url" >"$tmp/$asset"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$tmp/$asset" | cut -d ' ' -f 1)"
  else
    actual="$(shasum -a 256 "$tmp/$asset" | cut -d ' ' -f 1)"
  fi
  if [ "$actual" != "$sha256" ]; then
    echo "pmg: sha256 mismatch for $url" >&2
    return 1
  fi
  tar -xzf "$tmp/$asset" -C "$tmp"
  mkdir -p "$1"
  mv "$tmp/${asset%.tar.gz}/uv" "$1/uv"
  rm -rf "$tmp"
  trap - EXIT
}

uv="$(command -v uv 2>/dev/null || true)"
if [ -z "$uv" ]; then
  uv_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zshsetup/uv"
  uv="$uv_dir/uv"
  [ -x "$uv" ] || bootstrap_uv "$uv_dir"
fi

# a Python of uv, as the one of the system may be too old or change with its upgrades; the source
# is written last, so an interrupted install is redone
"$uv" venv --quiet --clear --managed-python --python 3.13 "$venv"
if [ -d "$pmg" ]; then
  "$uv" pip install --quiet --python "$venv/bin/python" --editable "$pmg"
else
  "$uv" pip install --quiet --python "$venv/bin/python" "$pmg"
fi
printf '%s\n' "$pmg" >"$venv/.source"
exec "$venv/bin/python" -m pmg "$@"
